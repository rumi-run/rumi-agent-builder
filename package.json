{
  "name": "rumi-agent-builder",
  "version": "1.0.2",
  "private": false,
  "description": "RUMI Agent Builder - Visual AI agent planning platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npx vite --host 0.0.0.0 --port 5173",
    "dev:server": "cd server && node index.js",
    "build": "cd client && npx vite build",
    "preview": "cd client && npx vite preview",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build",
    "audit:security": "npm audit --audit-level=high && npm --prefix client audit --audit-level=high"
  },
  "keywords": [
    "rumi",
    "agent",
    "builder",
    "ai"
  ],
  "author": "RUMI",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
